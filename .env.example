POSTGRES_DB=sports_betting_ai_development
POSTGRES_USER=sports_ai
POSTGRES_PASSWORD=replace_for_your_local_environment
# Host port mapped to the postgres container. 5434 avoids the local PostgreSQL
# server that commonly occupies 5432 on developer machines.
POSTGRES_PORT=5434
# Separate database used only by the RSpec suite; it is dropped and recreated.
POSTGRES_TEST_DB=sports_betting_ai_test
REDIS_PORT=6379
ML_PORT=8000
WEB_PORT=3000
